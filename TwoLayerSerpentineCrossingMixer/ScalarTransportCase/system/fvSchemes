FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}

ddtSchemes
{
    default         steadyState;
}
gradSchemes
{
    default         Gauss linear;
    gradT           cellLimited pointCellsLeastSquares 1;
}
divSchemes
{
    default         none;
    div(phi,T)      Gauss linearUpwind gradT;
}
laplacianSchemes
{
    default         Gauss linear corrected;
}
interpolationSchemes
{
    default         linear;
}
snGradSchemes
{
    default         corrected;
}
