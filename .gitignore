*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
.ipynb_checkpoints/

# C++ build artifacts
*.o
linux*/

# OpenFOAM runtime
polyMesh/
dynamicCode/
*.foam
[0-9]*/
processor*/
postProcessing/
VTK/
*.OpenFOAM
lnInclude/

# Keep the canonical initial conditions; ignore other generated fields at time 0.
!PlanarAlternatingDeflectorMixer/FlowCase/0/
PlanarAlternatingDeflectorMixer/FlowCase/0/*
!PlanarAlternatingDeflectorMixer/FlowCase/0/U
!PlanarAlternatingDeflectorMixer/FlowCase/0/p
!PlanarAlternatingDeflectorMixer/ScalarTransportCase/0/
PlanarAlternatingDeflectorMixer/ScalarTransportCase/0/*
!PlanarAlternatingDeflectorMixer/ScalarTransportCase/0/T

# Keep the canonical M10 initial conditions; ignore generated later times.
!TwoLayerSerpentineCrossingMixer/FlowCase/0/
TwoLayerSerpentineCrossingMixer/FlowCase/0/*
!TwoLayerSerpentineCrossingMixer/FlowCase/0/U
!TwoLayerSerpentineCrossingMixer/FlowCase/0/p
!TwoLayerSerpentineCrossingMixer/ScalarTransportCase/0/
TwoLayerSerpentineCrossingMixer/ScalarTransportCase/0/*
!TwoLayerSerpentineCrossingMixer/ScalarTransportCase/0/T

# Mesh and geometry
*.stl
*.msh
bubble-contour/TaylorBubbleSTL/

# Data
*.csv
bubble-contour/*-Spline.csv
*analyzed

