.ccls-cache/
.claude/
sync.ffs_db
*.swp

# Snakemake 
.snakemake/

# Reproducible micromixer runtime products
# Campaign output is 3.4 GB of fields and meshes and stays out of the repository.
# The small summaries do ship: the teaching exercises read all_samples.csv, and
# the README quotes screening_gate.json and baseline_summary.csv.
PlanarAlternatingDeflectorMixer/results/*
!PlanarAlternatingDeflectorMixer/results/corrected_boundary_v3*/
PlanarAlternatingDeflectorMixer/results/corrected_boundary_v3*/*
!PlanarAlternatingDeflectorMixer/results/corrected_boundary_v3*/all_samples.csv
!PlanarAlternatingDeflectorMixer/results/corrected_boundary_v3*/screening_gate.json
!PlanarAlternatingDeflectorMixer/results/corrected_boundary_v3*/baseline_summary.csv
PlanarAlternatingDeflectorMixer/FlowCase/constant/triSurface/geometry_manifest.json

# M10 generated geometry and multifidelity campaign products
TwoLayerSerpentineCrossingMixer/generated/
TwoLayerSerpentineCrossingMixer/results/

# Model files
*.pt

# Apptainer images are build products, not source.
apptainer/*.sif
*.sif

# Orchestrator job ids recorded by run-bo.sbatch (see CLUSTER.md).
.padm_jobs

# wmake build artifacts. $WM_OPTIONS is linux64GccDPInt32Opt for EVERY
# OpenFOAM version, so a stale tree from another version looks current and is
# not -- see Allwclean in apptainer/README.md.
src/functionObjects/Make/linux*/
src/**/lnInclude/

# Source slide decks supplied as INPUT material. Large binaries, not authored
# here, and not to be modified -- the HTML decks in docs/ are derived from them.
*.pptx
*.ppt
PlanarAlternatingDeflectorMixer/docs/*.pdf

# WSL exposes NTFS alternate data streams as files; these appear next to any
# file downloaded on Windows and are never content.
*:Zone.Identifier
