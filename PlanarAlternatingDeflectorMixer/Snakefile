from pathlib import Path
import sys

shell.executable("/bin/bash")

CASE_ROOT = Path(workflow.basedir).resolve()
REPO_ROOT = CASE_ROOT.parent

# results_dir can be overridden per sample:
#   snakemake --workflow-profile profiles/local --config results_dir=results/manual_00
# Default is the single-run layout used by Allrun.
RESULTS_ROOT = Path(config.get("results_dir", str(CASE_ROOT / "results"))).resolve()
WORKFLOW = RESULTS_ROOT / ".workflow"

# ---------------------------------------------------------------------------
# Backend-independent knobs.  Defaults live in config/config.yaml; a workflow
# profile (profiles/local, profiles/local2, profiles/slurm) overrides them.
# There is deliberately NO `if cluster:` anywhere below -- the executor, the MPI
# launcher and the environment are all supplied from outside.
# ---------------------------------------------------------------------------

# MPI ranks for the two solve rules.  SINGLE SOURCE OF TRUTH: the decompose
# rules write `numberOfSubdomains {NP}` into both decomposeParDicts, so the
# committed dictionaries are never read and the launcher can never disagree
# with the number of processor* directories that decomposePar produced.
NP = int(config.get("np", 2))
assert NP >= 1, "np must be >= 1"

# `{np}` placeholder: mpirun needs an explicit rank count, srun does not because
# a SLURM allocation already carries it.  Keeping this a format string lets one
# mechanism serve both.  See config/config.yaml for why mpirun is correct here
# even under SLURM (MPI is container-internal), and for the wall/CPU diagnostic.
MPI = config.get("mpi_launcher", "mpirun -np {np}")
MPI_PREFIX = MPI.format(np=NP) + " "

# Shell preamble prepended to every rule, run under `set +eu`.
PREAMBLE = (config.get("env_preamble") or "").strip()

PYTHON_BIN = config.get("python_bin") or str(Path(sys.executable).resolve())

CAD_CONFIG_NAME = "alternating_deflector_cad.yaml"
CAD_SCRIPT_NAME = "alternating_deflector_cad.py"
RESEARCH_CONFIG = CASE_ROOT / "research_config.yaml"
MESH_VALIDATOR = CASE_ROOT / "validate_mesh_patches.py"
FLOW_VALIDATOR = CASE_ROOT / "validate_flow_balance.py"
FLOW_CONVERGENCE_VERIFIER = CASE_ROOT / "verify_flow_convergence.py"

TEMPLATE_HYDRO = CASE_ROOT / "FlowCase"
TEMPLATE_MIXING = CASE_ROOT / "ScalarTransportCase"
HYDRO = RESULTS_ROOT / "FlowCase"
MIXING = RESULTS_ROOT / "ScalarTransportCase"
HYDRO_FOAM  = str(HYDRO  / f"{HYDRO.name}.foam")
MIXING_FOAM = str(MIXING / f"{MIXING.name}.foam")
GEOMETRY_MANIFEST = HYDRO / "constant/triSurface/geometry_manifest.json"
MESH_VALIDATION = HYDRO / "mesh_validation.json"
FLOW_VALIDATION = HYDRO / "flow_validation.json"

# Explicit source inputs make edits to the template cases invalidate the
# staging rule. The optional per-sample config is included when BO creates it.
STAGE_INPUTS = [
    str(RESEARCH_CONFIG),
    str(MESH_VALIDATOR),
    str(FLOW_VALIDATOR),
    str(FLOW_CONVERGENCE_VERIFIER),
    str(TEMPLATE_HYDRO / CAD_CONFIG_NAME),
    str(TEMPLATE_HYDRO / CAD_SCRIPT_NAME),
    str(TEMPLATE_HYDRO / "0/U"),
    str(TEMPLATE_HYDRO / "0/p"),
    *[str(path) for path in sorted((TEMPLATE_HYDRO / "constant").glob("*Properties"))],
    *[str(path) for path in sorted((TEMPLATE_HYDRO / "system").iterdir()) if path.is_file()],
    str(TEMPLATE_MIXING / "0/T"),
    *[str(path) for path in sorted((TEMPLATE_MIXING / "constant").glob("*Properties"))],
    *[str(path) for path in sorted((TEMPLATE_MIXING / "system").iterdir()) if path.is_file()],
]
SAMPLE_CONFIG = RESULTS_ROOT / CAD_CONFIG_NAME
if SAMPLE_CONFIG.exists():
    STAGE_INPUTS.append(str(SAMPLE_CONFIG))

# Optional per-sample T-field PNG rendered without ParaView or OpenGL.
# RESULTS_ROOT.name == sample ID (e.g. "00000") when invoked by the BO loop.
SAMPLE_PNG = RESULTS_ROOT / "visualizations" / f"{RESULTS_ROOT.name}_T.png"

VISUALIZE_SAMPLE_DONE = WORKFLOW / "visualize_sample.done"
FIELD_RENDER_SCRIPT = CASE_ROOT / "render_latest_mixing_field.py"

# Recorded so the BO driver can tell a PHYSICS failure (a design that genuinely
# will not mesh or will not converge -- data, and correctly excluded from the
# GP) from a LAUNCH failure (a missing binary, an unbound path, a bad container,
# a rejected sbatch -- not data, and must never be recorded as a design result).
FAILED_RULE = WORKFLOW / "failed_rule"

def sh(rule_name, *lines):
    """Shell body for one rule.

    Order matters.  The environment preamble runs FIRST and under `set +eu`,
    because OpenFOAM's etc/bashrc reads unset variables (WM_PROJECT_DIR among
    them) and sourcing it under `set -u` aborts every job before it starts.
    Only then does the OpenFOAM guard run -- checking for foamDictionary before
    the preamble that provides it would fail every containerised rule.  The
    rule's own commands then run strictly, under `set -e`.

    The EXIT trap records which rule failed.  Nothing is swallowed: the exit
    code still propagates, the log still lands in the case directory, and the
    marker only adds the one fact the driver cannot otherwise recover from a
    non-zero snakemake return.
    """
    pre = (PREAMBLE + "\n") if PREAMBLE else ""
    guard = (
        'if ! command -v foamDictionary >/dev/null 2>&1; then\n'
        '    echo "ERROR: OpenFOAM is not configured. Source its etc/bashrc first." >&2\n'
        '    exit 1\n'
        'fi\n'
        'if [ -z "${{WM_OPTIONS:-}}" ]; then\n'
        '    echo "ERROR: WM_OPTIONS is unset. Source the OpenFOAM environment." >&2\n'
        '    exit 1\n'
        'fi\n'
        f'export FOAM_USER_LIBBIN="{REPO_ROOT}/platforms/$WM_OPTIONS/lib"\n'
        'export LD_LIBRARY_PATH="$FOAM_USER_LIBBIN:$LD_LIBRARY_PATH"\n'
    )
    trap = (
        f'__padm_rule="{rule_name}"\n'
        f'__padm_marker="{FAILED_RULE}"\n'
        'trap \'__rc=$?; if [ "$__rc" -ne 0 ]; then '
        'mkdir -p "$(dirname "$__padm_marker")"; '
        'printf "%s\\t%s\\n" "$__padm_rule" "$__rc" >> "$__padm_marker"; '
        'fi\' EXIT\n'
    )
    # `pipefail` is NOT decoration: every solver and mesher below is piped
    # through `tee` to keep its log, and without it the pipeline would report
    # tee's exit status and a crashed cartesian2DMesh or simpleFoam would be
    # recorded as a success.
    return "set +eu\n" + pre + guard + trap + "set -eo pipefail\n" + "\n".join(lines) + "\n"


localrules: all, clean, visualize


rule all:
    threads: 1
    input:
        str(RESULTS_ROOT / "objectives.csv"),
        HYDRO_FOAM,
        MIXING_FOAM,
        str(WORKFLOW / "mixing_post_process.done"),
        str(VISUALIZE_SAMPLE_DONE),
        str(MESH_VALIDATION),
        str(FLOW_VALIDATION),


# ---------------------------------------------------------------------------
# GROUP "case_pre" -- every serial step from staging to a decomposed flow case.
#
# Grouping matters only on SLURM, where it turns five sbatch round-trips into
# one.  The two solves are deliberately LEFT OUT of any group: a mixed group is
# submitted as a single sbatch whose allocation does not reliably carry the
# solve's rank count, and the launcher then fails with "More processors
# requested than permitted" / "not enough slots".  Ungrouped, each solve gets
# its own allocation sized by its own `threads`.
# ---------------------------------------------------------------------------

rule stage_template_cases:
    threads: 1
    group: "case_pre"
    input:
        STAGE_INPUTS,
    output:
        done = str(WORKFLOW / "stage_template_cases.done"),
        yaml = str(HYDRO / CAD_CONFIG_NAME),
    shell:
        sh("stage_template_cases",
        """
        mkdir -p "{RESULTS_ROOT}" "{WORKFLOW}"

        rm -rf "{HYDRO}" "{MIXING}"
        cp -a "{TEMPLATE_HYDRO}" "{HYDRO}"
        cp -a "{TEMPLATE_MIXING}" "{MIXING}"

        cd "{HYDRO}"
        rm -rf constant/polyMesh
        rm -f constant/triSurface/alternating_deflector_mixer.stl
        rm -f constant/triSurface/geometry_manifest.json
        rm -f 0/V
        rm -rf processor*
        find . -maxdepth 1 -mindepth 1 -type d -regex './[1-9][0-9]*' -exec rm -rf {{}} +
        rm -f badSurfaceWithSubsets.fms
        rm -f pressureDrop.csv
        rm -f mesh_validation.json flow_validation.json
        rm -rf postProcessing
        rm -rf __pycache__
        rm -f log.*
        rm -f ./*.foam

        cd "{MIXING}"
        rm -rf constant/polyMesh
        rm -f 0/U 0/phi
        rm -rf processor*
        find . -maxdepth 1 -mindepth 1 -type d -regex './[1-9][0-9]*' -exec rm -rf {{}} +
        rm -f mixing.csv
        rm -rf postProcessing
        rm -rf __pycache__
        rm -f log.*
        rm -f ./*.foam

        # If a sample YAML was placed in results_dir by the BO loop, use it
        # verbatim so the full CAD parameter set (including k) carries through.
        if [ -f "{SAMPLE_CONFIG}" ]; then
            cp "{SAMPLE_CONFIG}" "{HYDRO}/{CAD_CONFIG_NAME}"
        fi

        touch "{output.done}"
        """)


rule hydro_geometry:
    threads: 1
    group: "case_pre"
    input:
        str(WORKFLOW / "stage_template_cases.done"),
    output:
        stl = str(HYDRO / "constant/triSurface/alternating_deflector_mixer.stl"),
        manifest = str(GEOMETRY_MANIFEST),
    shell:
        sh("hydro_geometry",
        """
        cd "{HYDRO}"
        "{PYTHON_BIN}" "{CAD_SCRIPT_NAME}" 2>&1 | tee log.alternating_deflector_cad
        """)


rule hydro_mesh:
    threads: 1
    group: "case_pre"
    input:
        stl = str(HYDRO / "constant/triSurface/alternating_deflector_mixer.stl"),
        manifest = str(GEOMETRY_MANIFEST),
        mesh_dict = str(TEMPLATE_HYDRO / "system/meshDict"),
        validator = str(MESH_VALIDATOR),
        research_config = str(RESEARCH_CONFIG),
    output:
        boundary = str(HYDRO / "constant/polyMesh/boundary"),
        points = str(HYDRO / "constant/polyMesh/points"),
        report = str(MESH_VALIDATION),
    shell:
        sh("hydro_mesh",
        """
        cp "{TEMPLATE_HYDRO}/system/meshDict" "{HYDRO}/system/meshDict"
        cd "{HYDRO}"
        cartesian2DMesh 2>&1 | tee log.cartesian2DMesh
        # Fail early if cfMesh could not eliminate zero-area faces.
        # "Number of bad faces N" lines appear in the smoothing loop; the last
        # value is what remains in the final mesh.  If N > 0 the mesh is invalid
        # and simpleFoam will crash with a floating-point exception.
        last_bad=$(grep "Number of bad faces" log.cartesian2DMesh | tail -1 | awk '{{print $NF}}')
        if [ -n "$last_bad" ] && [ "$last_bad" -gt 0 ]; then
            echo "ERROR: cfMesh left $last_bad zero-area face(s) in the mesh — aborting" >&2
            exit 1
        fi
        checkMesh -allGeometry -allTopology 2>&1 | tee log.checkMesh
        grep -q "Mesh OK" log.checkMesh || {{
            echo "ERROR: checkMesh did not report Mesh OK" >&2
            exit 1
        }}
        "{PYTHON_BIN}" "{input.validator}" \
            --case "{HYDRO}" \
            --manifest "{input.manifest}" \
            --research-config "{input.research_config}" \
            --output "{output.report}"
        """)


rule hydro_cell_volumes:
    threads: 1
    group: "case_pre"
    input:
        str(HYDRO / "constant/polyMesh/boundary"),
    output:
        str(HYDRO / "0/V"),
    shell:
        sh("hydro_cell_volumes",
        """
        cd "{HYDRO}"
        postProcess -func writeCellVolumes -time 0 2>&1 | tee log.postProcess
        """)


# decomposePar is SERIAL -- it is the step that CREATES the parallel case, so it
# cannot be one.  threads: 1 (it was NPROCS, which only ever reserved cores that
# went unused).  It is also the most memory-hungry rule in the workflow: scotch
# holds the cell connectivity graph on top of the whole mesh in one process,
# which is why profiles/slurm gives its group the fat mem_mb_per_cpu.
rule hydro_decompose:
    threads: 1
    group: "case_pre"
    input:
        str(HYDRO / "0/V"),
    output:
        str(WORKFLOW / "hydro_decompose.done"),
    shell:
        sh("hydro_decompose",
        """
        mkdir -p "{WORKFLOW}"
        cd "{HYDRO}"
        # scotch partitions the cell connectivity graph, so there are no
        # per-direction coeffs whose product must equal np: any NP works for any
        # 2D or 3D mesh.  numberOfSubdomains comes from NP, never from the
        # committed dictionary.
        foamDictionary -entry method -set scotch system/decomposeParDict
        foamDictionary -entry numberOfSubdomains -set {NP} system/decomposeParDict
        decomposePar -force 2>&1 | tee log.decomposePar
        touch "{output}"
        """)


# ---------------------------------------------------------------------------
# SOLVE 1 -- the only MPI rule of the hydrodynamic stage.  UNGROUPED on purpose.
# ---------------------------------------------------------------------------

rule hydro_simpleFoam:
    threads: NP
    resources:
        # ONE NODE.  The ranks must share a node for the launcher to be able to
        # create its job step; SLURM will otherwise happily satisfy the task
        # count across two nodes and leave the batch step short of CPUs.  This
        # MUST be the plugin's own `nodes` resource -- the executor rejects
        # --nodes inside slurm_extra at submission time, so no job is created.
        nodes=1,
    input:
        decomposed = str(WORKFLOW / "hydro_decompose.done"),
        verifier = str(FLOW_CONVERGENCE_VERIFIER),
        geometry = str(HYDRO / CAD_CONFIG_NAME),
    output:
        done    = str(WORKFLOW / "hydro_simpleFoam.done"),
        csv     = str(HYDRO / "pressureDrop.csv"),
    shell:
        sh("hydro_simpleFoam",
        """
        mkdir -p "{WORKFLOW}"
        cd "{HYDRO}"
        if grep -Eq '^topology:[[:space:]]*straight([[:space:]]|$)' "{input.geometry}"; then
            # The straight case uses a zero transverse velocity. Its relative
            # Uy residual is ill-conditioned, so run a bounded 600 iterations
            # and apply the dedicated pressure/Ux convergence verifier below.
            foamDictionary -entry endTime -set 600 system/controlDict
        fi
        {MPI_PREFIX}simpleFoam -parallel 2>&1 | tee log.simpleFoam
        if [ ! -f pressureDrop.csv ] && [ -f processor0/pressureDrop.csv ]; then
            cp processor0/pressureDrop.csv pressureDrop.csv
        fi
        [ -f pressureDrop.csv ] || {{ echo "ERROR: pressureDrop.csv not produced by pressureDrop FO"; exit 1; }}
        "{PYTHON_BIN}" "{input.verifier}" \
            log.simpleFoam pressureDrop.csv "{input.geometry}" \
            --window 100 --min-rows 400 --pressure-span-tol 1e-7 --residual-tol 1e-5
        touch "{output.done}"
        """)


# ---------------------------------------------------------------------------
# GROUP "hydro_post" -- reconstruct, validate, hand the flow field to the
# scalar case, initialise it, decompose it.  All serial.
#
# Note the OpenFOAM ordering: field initialisation (setExprFields) runs BEFORE
# decomposePar, serially, on the whole case.  That is the standard order and it
# is also free of parallel artefacts -- no processor-boundary exchange at all.
# ---------------------------------------------------------------------------

rule hydro_reconstruct:
    threads: 1
    group: "hydro_post"
    input:
        str(WORKFLOW / "hydro_simpleFoam.done"),
    output:
        str(WORKFLOW / "hydro_reconstruct.done"),
    shell:
        sh("hydro_reconstruct",
        """
        mkdir -p "{WORKFLOW}"
        cd "{HYDRO}"
        reconstructPar -latestTime 2>&1 | tee log.reconstructPar
        touch "{output}"
        """)


rule hydro_validate_flow:
    threads: 1
    group: "hydro_post"
    input:
        reconstructed = str(WORKFLOW / "hydro_reconstruct.done"),
        manifest = str(GEOMETRY_MANIFEST),
        validator = str(FLOW_VALIDATOR),
        research_config = str(RESEARCH_CONFIG),
    output:
        str(FLOW_VALIDATION),
    shell:
        sh("hydro_validate_flow",
        """
        "{PYTHON_BIN}" "{input.validator}" \
            --case "{HYDRO}" \
            --manifest "{input.manifest}" \
            --research-config "{input.research_config}" \
            --output "{output}"
        """)


rule copy_hydro_to_mixing:
    threads: 1
    group: "hydro_post"
    input:
        str(HYDRO / "pressureDrop.csv"),
        str(HYDRO / "constant/polyMesh/boundary"),
        str(WORKFLOW / "hydro_reconstruct.done"),
        str(FLOW_VALIDATION),
    output:
        str(MIXING / "constant/polyMesh/boundary"),
        str(MIXING / "0/U"),
        str(MIXING / "0/phi"),
        str(WORKFLOW / "copy_hydro_to_mixing.done"),
    shell:
        sh("copy_hydro_to_mixing",
        """
        mkdir -p "{WORKFLOW}"

        latest_time=$(cd "{HYDRO}" && foamListTimes -latestTime)

        rm -rf "{MIXING}/constant/polyMesh"
        mkdir -p "{MIXING}/constant"
        cp -r "{HYDRO}/constant/polyMesh" "{MIXING}/constant/"
        cp "{HYDRO}/${{latest_time}}/U" "{MIXING}/0/U"
        cp "{HYDRO}/${{latest_time}}/phi" "{MIXING}/0/phi"

        touch "{output[3]}"
        """)


rule mixing_set_expr_fields:
    threads: 1
    group: "hydro_post"
    input:
        str(WORKFLOW / "copy_hydro_to_mixing.done"),
    output:
        str(WORKFLOW / "mixing_set_expr_fields.done"),
    shell:
        sh("mixing_set_expr_fields",
        """
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        setExprFields -dict system/setExprFieldsDict -time 0 2>&1 | tee log.setExprFields
        touch "{output}"
        """)


rule mixing_decompose:
    threads: 1
    group: "hydro_post"
    input:
        str(WORKFLOW / "mixing_set_expr_fields.done"),
    output:
        str(WORKFLOW / "mixing_decompose.done"),
    shell:
        sh("mixing_decompose",
        """
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        foamDictionary -entry method -set scotch system/decomposeParDict
        foamDictionary -entry numberOfSubdomains -set {NP} system/decomposeParDict
        decomposePar -force 2>&1 | tee log.decomposePar
        touch "{output}"
        """)


# ---------------------------------------------------------------------------
# SOLVE 2 -- the only MPI rule of the scalar stage.  UNGROUPED on purpose.
# ---------------------------------------------------------------------------

rule mixing_scalar_transport:
    threads: NP
    resources:
        nodes=1,
    input:
        decomposed = str(WORKFLOW / "mixing_decompose.done"),
        verifier = str(CASE_ROOT / "verify_scalar_convergence.py"),
        geometry = str(HYDRO / CAD_CONFIG_NAME),
    output:
        done    = str(WORKFLOW / "mixing_scalar_transport.done"),
        csv     = str(MIXING / "mixing.csv"),
    shell:
        sh("mixing_scalar_transport",
        """
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        # Advance in bounded chunks and stop only when the objective itself is
        # stable. Algebraic residual convergence alone was shown not to imply a
        # stationary outlet metric in the corrected high-Peclet cases.
        foamDictionary -entry startFrom -set latestTime system/controlDict
        foamDictionary -entry SIMPLE/residualControl/T -set 1e-12 system/fvSolution
        : > log.scalarTransportFoam
        converged=0
        for target_end in 600 1200 1800 2400; do
            foamDictionary -entry endTime -set "$target_end" system/controlDict
            {MPI_PREFIX}scalarTransportFoam -parallel 2>&1 | tee -a log.scalarTransportFoam
            if [ ! -f mixing.csv ] && [ -f processor0/mixing.csv ]; then
                cp processor0/mixing.csv mixing.csv
            fi
            if [ -f mixing.csv ] && \
               "{PYTHON_BIN}" "{input.verifier}" mixing.csv \
                   --window 50 --min-rows 200 --intensity-tol 1e-4 --mean-tol 1e-4; then
                converged=1
                break
            fi
            echo "[scalar-convergence] objective not stable by $target_end; continuing sequentially"
        done
        if [ "$converged" -ne 1 ]; then
            echo "ERROR: scalar objective did not stabilize by 2400 iterations" >&2
            exit 1
        fi
        touch "{output.done}"
        """)


# ---------------------------------------------------------------------------
# GROUP "case_post" -- reconstruct, render, agglomerate the objectives.
# ---------------------------------------------------------------------------

rule mixing_reconstruct:
    threads: 1
    group: "case_post"
    input:
        str(WORKFLOW / "mixing_scalar_transport.done"),
    output:
        str(WORKFLOW / "mixing_reconstruct.done"),
    shell:
        sh("mixing_reconstruct",
        """
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        reconstructPar -latestTime 2>&1 | tee log.reconstructPar
        touch "{output}"
        """)


rule mixing_post_process:
    """Legacy samplingPlane hook kept for workflow compatibility.

    The old OpenFOAM samplingPlane export is disabled in favour of a Python
    foamlib/VTK render from the reconstructed mixing case.
    """
    threads: 1
    group: "case_post"
    input:
        str(WORKFLOW / "mixing_reconstruct.done"),
    output:
        str(WORKFLOW / "mixing_post_process.done"),
    shell:
        sh("mixing_post_process",
        """
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        # Legacy path kept for reference only:
        # postProcess -func samplingPlane -latestTime 2>&1 | tee log.postProcess_samplingPlane
        echo "WARNING: legacy samplingPlane post-processing is disabled; using Python foamlib/VTK rendering instead." | tee log.postProcess_samplingPlane
        touch "{output}"
        """)


rule visualize_sample:
    """Render the latest reconstructed field with foamlib, VTK, and Pillow.

    Rendering is deliberately non-fatal because the PNG is not a BO objective.
    """
    threads: 1
    group: "case_post"
    input:
        str(WORKFLOW / "mixing_post_process.done"),
        foam = MIXING_FOAM,
    output:
        str(VISUALIZE_SAMPLE_DONE),
    shell:
        sh("visualize_sample",
        """
        mkdir -p "{WORKFLOW}" "{RESULTS_ROOT}/visualizations"
        rm -f "{RESULTS_ROOT}/visualizations/visualization.warning.log"
        if ! "{PYTHON_BIN}" "{FIELD_RENDER_SCRIPT}" \
                --case-foam "{input.foam}" \
                --output "{SAMPLE_PNG}" \
                --field T; then
            echo "WARNING: Python field rendering failed for sample {RESULTS_ROOT.name}; BO objectives are complete and the workflow will continue." | tee "{RESULTS_ROOT}/visualizations/visualization.warning.log" >&2
            rm -f "{SAMPLE_PNG}"
        fi
        touch "{output}"
        """)


rule create_foam_files:
    threads: 1
    group: "case_post"
    input:
        str(HYDRO / "pressureDrop.csv"),
        str(MIXING / "mixing.csv"),
    output:
        HYDRO_FOAM,
        MIXING_FOAM,
    shell:
        sh("create_foam_files",
        """
        touch "{HYDRO_FOAM}"
        touch "{MIXING_FOAM}"
        """)


rule agglomerate:
    threads: 1
    group: "case_post"
    input:
        yaml    = str(HYDRO / CAD_CONFIG_NAME),
        pdrop   = str(HYDRO / "pressureDrop.csv"),
        mixing  = str(MIXING / "mixing.csv"),
        flow_validation = str(FLOW_VALIDATION),
        research_config = str(RESEARCH_CONFIG),
    output:
        str(RESULTS_ROOT / "objectives.csv"),
    shell:
        sh("agglomerate",
        """
        "{PYTHON_BIN}" "{CASE_ROOT}/postprocessing_agglomeration.py" \
            --yaml        "{input.yaml}"   \
            --pdrop       "{input.pdrop}"  \
            --mixing      "{input.mixing}" \
            --flow-validation "{input.flow_validation}" \
            --research-config "{input.research_config}" \
            --output      "{output}"       \
            --results-dir "{RESULTS_ROOT}"
        """)


# ---------------------------------------------------------------------------
# Campaign-level targets (never part of a single design's DAG).
# ---------------------------------------------------------------------------

rule visualize:
    """Build the animated Pareto-front movie from all completed samples.

    Reads all_samples.csv and the per-sample PNGs produced by
    visualize_sample, then writes to results/visualizations/:
      pareto_animation.gif   — always produced (Pillow)
      pareto_animation.mp4   — produced when ffmpeg is available

    Run after all BO samples are complete:
        snakemake --workflow-profile profiles/local visualize
    """
    threads: 1
    input:
        str(RESULTS_ROOT / "all_samples.csv"),
    output:
        str(RESULTS_ROOT / "visualizations" / "pareto_animation.gif"),
    shell:
        # Not sh(): this is matplotlib and Pillow only, so gating it on a sourced
        # OpenFOAM would make plotting a finished campaign impossible from a
        # plain shell.
        """
        set -eo pipefail
        "{PYTHON_BIN}" "{CASE_ROOT}/visualize_results.py" \
            --results-dir "{RESULTS_ROOT}" \
            --output-dir  "{RESULTS_ROOT}/visualizations"
        """


rule clean:
    threads: 1
    shell:
        """
        set -eo pipefail
        find "{CASE_ROOT}" -type d -name __pycache__ -prune -exec rm -rf {{}} +
        rm -rf "{RESULTS_ROOT}"
        """
