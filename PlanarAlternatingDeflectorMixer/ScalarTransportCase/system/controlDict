FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     scalarTransportFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         600;

deltaT          1;

writeControl    timeStep;

writeInterval   1;

purgeWrite      1;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    patchMixingQuality
    {
        type                    patchMixingQuality;
        libs                    ("libbayesoptMixerFunctionObjects.so");

        scalarField             T;
        patch                   outlet;
        weighting               phi;
        meanMode                fromInletRatio;
        aMean                   0.5;
        epsilon                 1e-12;
        reportMixingIndex       true;
        reportAbsoluteDeviations true;
        csvFile                 mixing.csv;

        log                     true;
        writeControl    timeStep;
        writeInterval   1;
    }

    // Horizontal cut plane at z = DEPTH/2 = 5e-6 m.
    // Writes VTK surface with U and T fields.
    // Executed explicitly via: postProcess -func samplingPlane -latestTime
    // (see system/samplingPlane for the standalone function dict)
    samplingPlane
    {
        type            surfaces;
        libs            ("libsampling.so");

        writeControl    onEnd;

        surfaceFormat   vtk;
        interpolationScheme cellPoint;

        fields          (U T);

        surfaces
        (
            midPlane
            {
                type         cuttingPlane;
                planeType    pointAndNormal;
                pointAndNormalDict
                {
                    basePoint    (0 0 5e-6);
                    normalVector (0 0 1);
                }
                interpolate  true;
            }
        );
    }
}


