#!/bin/bash
set -euo pipefail

CASE_DIR="$(cd "${0%/*}" && pwd)"
cd "$CASE_DIR" || exit 1

rm -rf constant/polyMesh
rm -f 0/U 0/phi
rm -rf processor*
find . -maxdepth 1 -mindepth 1 -type d -regex './[1-9][0-9]*' -exec rm -rf {} +
rm -f mixing.csv
rm -rf postProcessing
rm -f log.*
rm -f ./*.foam
find . -type d -name __pycache__ -prune -exec rm -rf {} +
