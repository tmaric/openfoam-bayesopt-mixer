FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setExprFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Initialise T: 1 in bottom half of channel (y < H/2 = 5e-4 m), 0 in top half.
// H = 1 mm (scale=1e-3), H/2 = 5e-4 m.

expressions
(
    T
    {
        field       T;
        dimensions  [0 0 0 0 0 0 0];
        expression  "pos().y() < 5e-4 ? 1.0 : 0.0";
    }
);


