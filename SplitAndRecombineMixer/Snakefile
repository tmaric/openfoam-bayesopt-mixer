from pathlib import Path
import shutil
import sys

shell.executable("/bin/bash")

CASE_ROOT = Path(workflow.basedir).resolve()
REPO_ROOT = CASE_ROOT.parent

# results_dir can be overridden per sample:
#   snakemake --cores 4 --config results_dir=samples/00
# Default is the single-run layout used by Allrun.
RESULTS_ROOT = Path(config.get("results_dir", str(CASE_ROOT / "results"))).resolve()
WORKFLOW = RESULTS_ROOT / ".workflow"

TEMPLATE_HYDRO = CASE_ROOT / "SplitAndRecombineHydro"
TEMPLATE_MIXING = CASE_ROOT / "SplitAndRecombineMixing"
HYDRO = RESULTS_ROOT / "SplitAndRecombineHydro"
MIXING = RESULTS_ROOT / "SplitAndRecombineMixing"
HYDRO_FOAM  = str(HYDRO  / f"{HYDRO.name}.foam")
MIXING_FOAM = str(MIXING / f"{MIXING.name}.foam")

NPROCS = max(1, int(workflow.cores))

# Optional per-sample T-field PNG rendered with ParaView batch mode.
# RESULTS_ROOT.name == sample ID (e.g. "00000") when invoked by the BO loop.
SAMPLE_PNG = RESULTS_ROOT / "visualizations" / f"{RESULTS_ROOT.name}_T.png"

VISUALIZE_SAMPLE_DONE = WORKFLOW / "visualize_sample.done"
PARAVIEW_RENDER_SCRIPT = CASE_ROOT / "render_latest_mixing_field.py"
PARAVIEW_BATCH = shutil.which("pvpython") or shutil.which("pvbatch")
if PARAVIEW_BATCH is None:
    print(
        "WARNING: ParaView batch executable (pvpython/pvbatch) not found; "
        "sample field visualization will be skipped.",
        file=sys.stderr,
    )

shell.prefix(
    "set -eo pipefail; "
    "if ! command -v foamDictionary >/dev/null 2>&1; then "
    ". \"$HOME/OpenFOAM/OpenFOAM-v2506/etc/bashrc\" "
    "|| (echo \"ERROR: cannot source OpenFOAM environment\"; exit 1); "
    "fi; "
    f"export FOAM_USER_LIBBIN=\"{REPO_ROOT}/platforms/$WM_OPTIONS/lib\"; "
    "export LD_LIBRARY_PATH=\"$FOAM_USER_LIBBIN:$LD_LIBRARY_PATH\"; "
)


rule all:
    threads: 1
    input:
        str(RESULTS_ROOT / "objectives.csv"),
        HYDRO_FOAM,
        MIXING_FOAM,
        str(WORKFLOW / "mixing_post_process.done"),
        str(VISUALIZE_SAMPLE_DONE),


rule stage_template_cases:
    threads: 1
    input:
        str(TEMPLATE_HYDRO),
        str(TEMPLATE_MIXING),
    output:
        done = str(WORKFLOW / "stage_template_cases.done"),
        yaml = str(HYDRO / "sar_mixer_cad.yaml"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{RESULTS_ROOT}" "{WORKFLOW}"

        rm -rf "{HYDRO}" "{MIXING}"
        cp -a "{TEMPLATE_HYDRO}" "{HYDRO}"
        cp -a "{TEMPLATE_MIXING}" "{MIXING}"

        cd "{HYDRO}"
        rm -rf constant/polyMesh
        rm -f constant/triSurface/sar_mixer.stl
        rm -f 0/V
        rm -rf processor*
        find . -maxdepth 1 -mindepth 1 -type d -regex './[1-9][0-9]*' -exec rm -rf {{}} +
        rm -f badSurfaceWithSubsets.fms
        rm -f pressureDrop.csv
        rm -rf postProcessing
        rm -rf __pycache__
        rm -f log.*
        rm -f ./*.foam

        cd "{MIXING}"
        rm -rf constant/polyMesh
        rm -f 0/U 0/phi
        rm -rf processor*
        find . -maxdepth 1 -mindepth 1 -type d -regex './[1-9][0-9]*' -exec rm -rf {{}} +
        rm -f mixing.csv
        rm -rf postProcessing
        rm -rf __pycache__
        rm -f log.*
        rm -f ./*.foam

        # If a sample YAML was placed in results_dir by the BO loop, use it.
        if [ -f "{RESULTS_ROOT}/sar_mixer_cad.yaml" ]; then
            cp "{RESULTS_ROOT}/sar_mixer_cad.yaml" "{HYDRO}/sar_mixer_cad.yaml"
        fi

        touch "{output.done}"
        """


rule hydro_geometry:
    threads: 1
    input:
        str(WORKFLOW / "stage_template_cases.done"),
    output:
        str(HYDRO / "constant/triSurface/sar_mixer.stl"),
    shell:
        """
        set -eo pipefail
        cd "{HYDRO}"
        python3 sar_mixer_cad.py 2>&1 | tee log.sar_mixer_cad
        """


rule hydro_mesh:
    threads: 1
    input:
        str(HYDRO / "constant/triSurface/sar_mixer.stl"),
        str(TEMPLATE_HYDRO / "system/meshDict"),
    output:
        str(HYDRO / "constant/polyMesh/boundary"),
        str(HYDRO / "constant/polyMesh/points"),
    shell:
        """
        set -eo pipefail
        cp "{TEMPLATE_HYDRO}/system/meshDict" "{HYDRO}/system/meshDict"
        cd "{HYDRO}"
        cartesian2DMesh 2>&1 | tee log.cartesian2DMesh
        # Fail early if cfMesh could not eliminate zero-area faces.
        # "Number of bad faces N" lines appear in the smoothing loop; the last
        # value is what remains in the final mesh.  If N > 0 the mesh is invalid
        # and simpleFoam will crash with a floating-point exception.
        last_bad=$(grep "Number of bad faces" log.cartesian2DMesh | tail -1 | awk '{{print $NF}}')
        if [ -n "$last_bad" ] && [ "$last_bad" -gt 0 ]; then
            echo "ERROR: cfMesh left $last_bad zero-area face(s) in the mesh — aborting" >&2
            exit 1
        fi
        """


rule hydro_cell_volumes:
    threads: 1
    input:
        str(HYDRO / "constant/polyMesh/boundary"),
    output:
        str(HYDRO / "0/V"),
    shell:
        """
        set -eo pipefail
        cd "{HYDRO}"
        postProcess -func writeCellVolumes -time 0 2>&1 | tee log.postProcess
        """


rule hydro_decompose:
    threads: NPROCS
    input:
        str(HYDRO / "0/V"),
    output:
        str(WORKFLOW / "hydro_decompose.done"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}"
        cd "{HYDRO}"
        foamDictionary -entry method -set scotch system/decomposeParDict
        foamDictionary -entry numberOfSubdomains -set {threads} system/decomposeParDict
        decomposePar -force 2>&1 | tee log.decomposePar
        touch "{output}"
        """


rule hydro_simpleFoam:
    threads: NPROCS
    input:
        str(WORKFLOW / "hydro_decompose.done"),
    output:
        done    = str(WORKFLOW / "hydro_simpleFoam.done"),
        csv     = str(HYDRO / "pressureDrop.csv"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}"
        cd "{HYDRO}"
        mpirun -np {threads} simpleFoam -parallel 2>&1 | tee log.simpleFoam
        if [ ! -f pressureDrop.csv ] && [ -f processor0/pressureDrop.csv ]; then
            cp processor0/pressureDrop.csv pressureDrop.csv
        fi
        [ -f pressureDrop.csv ] || {{ echo "ERROR: pressureDrop.csv not produced by pressureDrop FO"; exit 1; }}
        touch "{output.done}"
        """


rule hydro_reconstruct:
    threads: 1
    input:
        str(WORKFLOW / "hydro_simpleFoam.done"),
    output:
        str(WORKFLOW / "hydro_reconstruct.done"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}"
        cd "{HYDRO}"
        reconstructPar -latestTime 2>&1 | tee log.reconstructPar
        touch "{output}"
        """


rule copy_hydro_to_mixing:
    threads: 1
    input:
        str(HYDRO / "pressureDrop.csv"),
        str(HYDRO / "constant/polyMesh/boundary"),
        str(WORKFLOW / "hydro_reconstruct.done"),
    output:
        str(MIXING / "constant/polyMesh/boundary"),
        str(MIXING / "0/U"),
        str(MIXING / "0/phi"),
        str(WORKFLOW / "copy_hydro_to_mixing.done"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}"

        latest_time=$(cd "{HYDRO}" && foamListTimes -latestTime)

        rm -rf "{MIXING}/constant/polyMesh"
        mkdir -p "{MIXING}/constant"
        cp -r "{HYDRO}/constant/polyMesh" "{MIXING}/constant/"
        cp "{HYDRO}/${{latest_time}}/U" "{MIXING}/0/U"
        cp "{HYDRO}/${{latest_time}}/phi" "{MIXING}/0/phi"

        touch "{output[3]}"
        """


rule mixing_set_expr_fields:
    threads: 1
    input:
        str(WORKFLOW / "copy_hydro_to_mixing.done"),
    output:
        str(WORKFLOW / "mixing_set_expr_fields.done"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        setExprFields -dict system/setExprFieldsDict -time 0 2>&1 | tee log.setExprFields
        touch "{output}"
        """


rule mixing_decompose:
    threads: NPROCS
    input:
        str(WORKFLOW / "mixing_set_expr_fields.done"),
    output:
        str(WORKFLOW / "mixing_decompose.done"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        foamDictionary -entry method -set scotch system/decomposeParDict
        foamDictionary -entry numberOfSubdomains -set {threads} system/decomposeParDict
        decomposePar -force 2>&1 | tee log.decomposePar
        touch "{output}"
        """


rule mixing_scalar_transport:
    threads: NPROCS
    input:
        str(WORKFLOW / "mixing_decompose.done"),
    output:
        done    = str(WORKFLOW / "mixing_scalar_transport.done"),
        csv     = str(MIXING / "mixing.csv"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        mpirun -np {threads} scalarTransportFoam -parallel 2>&1 | tee log.scalarTransportFoam
        if [ ! -f mixing.csv ] && [ -f processor0/mixing.csv ]; then
            cp processor0/mixing.csv mixing.csv
        fi
        [ -f mixing.csv ] || {{ echo "ERROR: mixing.csv not produced by patchMixingQuality FO"; exit 1; }}
        touch "{output.done}"
        """


rule mixing_reconstruct:
    threads: 1
    input:
        str(WORKFLOW / "mixing_scalar_transport.done"),
    output:
        str(WORKFLOW / "mixing_reconstruct.done"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        reconstructPar -latestTime 2>&1 | tee log.reconstructPar
        touch "{output}"
        """


rule mixing_post_process:
    """Legacy samplingPlane hook kept for workflow compatibility.

    The old OpenFOAM samplingPlane export is disabled in favour of ParaView
    batch rendering from the reconstructed mixing case.
    """
    threads: 1
    input:
        str(WORKFLOW / "mixing_reconstruct.done"),
    output:
        str(WORKFLOW / "mixing_post_process.done"),
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}"
        cd "{MIXING}"
        # Legacy path kept for reference only:
        # postProcess -func samplingPlane -latestTime 2>&1 | tee log.postProcess_samplingPlane
        echo "WARNING: legacy samplingPlane post-processing is disabled; using ParaView batch rendering instead." | tee log.postProcess_samplingPlane
        touch "{output}"
        """


rule visualize_sample:
    """Render the latest reconstructed mixing field with ParaView in batch mode.

    When pvpython/pvbatch is unavailable, the render is skipped with a warning
    and the workflow continues without a per-sample PNG.
    """
    threads: 1
    input:
        str(WORKFLOW / "mixing_post_process.done"),
        foam = MIXING_FOAM,
    output:
        str(VISUALIZE_SAMPLE_DONE),
    params:
        paraview_batch = PARAVIEW_BATCH or "",
    shell:
        """
        set -eo pipefail
        mkdir -p "{WORKFLOW}" "{RESULTS_ROOT}/visualizations"
        if [ -n "{params.paraview_batch}" ]; then
            "{params.paraview_batch}" "{PARAVIEW_RENDER_SCRIPT}"                 --case-foam "{input.foam}"                 --output "{SAMPLE_PNG}"                 --field T
        else
            echo "WARNING: ParaView batch executable (pvpython/pvbatch) not found; skipping field visualization for sample {RESULTS_ROOT.name}." | tee "{RESULTS_ROOT}/visualizations/visualization.warning.log" >&2
        fi
        touch "{output}"
        """


rule visualize:
    """Build the animated Pareto-front movie from all completed samples.

    Reads all_samples.csv and the per-sample PNGs produced by
    visualize_sample, then writes to results/visualizations/:
      pareto_animation.gif   — always produced (Pillow)
      pareto_animation.mp4   — produced when ffmpeg is available

    Run after all BO samples are complete:
        snakemake --cores 1 visualize
    """
    threads: 1
    input:
        str(RESULTS_ROOT / "all_samples.csv"),
    output:
        str(RESULTS_ROOT / "visualizations" / "pareto_animation.gif"),
    shell:
        """
        set -eo pipefail
        python3 "{CASE_ROOT}/visualize_results.py" \
            --results-dir "{RESULTS_ROOT}" \
            --output-dir  "{RESULTS_ROOT}/visualizations"
        """


rule create_foam_files:
    threads: 1
    input:
        str(HYDRO / "pressureDrop.csv"),
        str(MIXING / "mixing.csv"),
    output:
        HYDRO_FOAM,
        MIXING_FOAM,
    shell:
        """
        set -eo pipefail
        touch "{HYDRO_FOAM}"
        touch "{MIXING_FOAM}"
        """


rule agglomerate:
    threads: 1
    input:
        yaml    = str(HYDRO / "sar_mixer_cad.yaml"),
        pdrop   = str(HYDRO / "pressureDrop.csv"),
        mixing  = str(MIXING / "mixing.csv"),
    output:
        str(RESULTS_ROOT / "objectives.csv"),
    shell:
        """
        set -eo pipefail
        python3 "{CASE_ROOT}/postprocessing_agglomeration.py" \
            --yaml        "{input.yaml}"   \
            --pdrop       "{input.pdrop}"  \
            --mixing      "{input.mixing}" \
            --output      "{output}"       \
            --results-dir "{RESULTS_ROOT}"
        """


rule clean:
    threads: 1
    shell:
        """
        set -eo pipefail
        find "{CASE_ROOT}" -type d -name __pycache__ -prune -exec rm -rf {{}} +
        rm -rf "{RESULTS_ROOT}"
        """
