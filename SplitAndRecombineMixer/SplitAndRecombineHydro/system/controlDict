FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     simpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         200;

deltaT          1;

writeControl    timeStep;

writeInterval   1;

purgeWrite      1;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

functions
{
    pressureDrop
    {
        type            pressureDrop;
        libs            ("libbayesoptMixerFunctionObjects.so");

        field           p;
        patch1          inlet;
        patch2          outlet;
        csvFile         pressureDrop.csv;

        log             true;
        writeControl    timeStep;
        writeInterval   1;
    }
}


