FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Normalized units matching sar_mixer_cad.py:
//   H      = 1.0         (channel height)
//   L0     = 2.0         (inlet/outlet buffer)
//   N      = 5           (unit cells)
//   L_cell = 4.0         (unit-cell length)
//   TOTAL_L = 2*L0 + N*L_cell = 24.0
//   DEPTH  = 0.1*H = 0.1
//
// Background mesh for snappyHexMesh obstacle subtraction.
// Cells are 0.1 x 0.1 x 0.1 (cubic) -> 240 x 10 x 1.
// Internal obstacles are added by snappyHexMesh using constant/triSurface/obstacles.stl.

scale   1;

vertices
(
    ( 0   0   0   )   // 0
    (24   0   0   )   // 1
    (24   1   0   )   // 2
    ( 0   1   0   )   // 3
    ( 0   0   0.1 )   // 4
    (24   0   0.1 )   // 5
    (24   1   0.1 )   // 6
    ( 0   1   0.1 )   // 7
);

blocks
(
    // hex (x- x+ corner ordering), (nx ny nz), grading
    hex (0 1 2 3 4 5 6 7) (240 10 1) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }
    walls
    {
        type wall;
        faces
        (
            (0 1 5 4)   // bottom  (y = 0)
            (3 7 6 2)   // top     (y = H)
        );
    }
    frontAndBack
    {
        type empty;
        faces
        (
            (0 3 2 1)   // front   (z = 0)
            (4 5 6 7)   // back    (z = DEPTH)
        );
    }
);


