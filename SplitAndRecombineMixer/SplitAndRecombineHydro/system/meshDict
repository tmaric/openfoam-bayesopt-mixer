FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      meshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// cfMesh meshDict for SAR lamination ladder mixer
// Mesher: cartesian2DMesh
//
// Geometry: constant/triSurface/sar_mixer.stl  (generated by sar_mixer_cad.py)
//   Named solid regions in the STL become OpenFOAM patches:
//     inlet   – inlet face  (x = 0)
//     outlet  – outlet face (x = TOTAL_L = 24 mm)
//     walls   – channel top/bottom walls + all obstacle surfaces
//   frontAndBack patch is created automatically by cfMesh from the z_min/z_max
//   vertex coordinates (z-normal faces must NOT be in the STL for the
//   is2DSurface() eigenvalue check to pass).
//
// SI metres.  SCALE = 1e-3 in sar_mixer_cad.py -> H = 1e-3 m, TOTAL_L = 24e-3 m
//
// Resolution targets (physical):
//   maxCellSize  ~ 5e-5 m  (0.05 mm) -> ~20 cells across H = 1 mm
//   near walls   = 1.25e-5 m (0.0125 mm) -> >=4 cells across t_m = 0.05 mm
//
// maxCellSize is 4.9999e-5 (not 5e-5) to avoid being an exact divisor of
// TOTAL_L = 0.024 m and H = 0.001 m, which causes cfMesh to produce 0 cells.

surfaceFile     "constant/triSurface/sar_mixer.stl";

// Global maximum cell size [m]
maxCellSize     4.9999e-5;

// Refined cells near all wall boundaries (channel walls + obstacle surfaces).
// refinementThickness controls how far the refinement zone extends from the
// surface into the fluid domain.
localRefinement
{
    walls
    {
        cellSize                1.25e-5;
        refinementThickness     1.5e-4;
    }
}


