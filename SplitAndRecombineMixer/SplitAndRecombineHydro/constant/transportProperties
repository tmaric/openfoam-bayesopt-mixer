FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel  Newtonian;

// Water at 20°C: nu = 1e-6 m²/s
// Re = U_mean * H / nu = 0.01 * 1e-3 / 1e-6 = 10
nu              1e-06;


