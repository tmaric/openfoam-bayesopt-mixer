#!/bin/bash
set -euo pipefail

ROOT_DIR="$(cd "${0%/*}" && pwd)"
cd "$ROOT_DIR"

if ! command -v wmake >/dev/null 2>&1 || [ -z "${WM_OPTIONS:-}" ]; then
    echo "ERROR: OpenFOAM is not configured. Source its etc/bashrc first." >&2
    exit 1
fi

# Keep the custom library inside the repository so a clone can be built and
# run without relying on a user-specific OpenFOAM installation directory.
export FOAM_USER_LIBBIN="$ROOT_DIR/platforms/$WM_OPTIONS/lib"
mkdir -p "$FOAM_USER_LIBBIN"

wmake libso src/functionObjects
